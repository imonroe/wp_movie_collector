{
    "name": "imonroe/wp-movie-collector",
    "description": "A WordPress plugin for collecting and managing your movie collection.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Ian Monroe",
            "homepage": "https://github.com/imonroe"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "yoast/phpunit-polyfills": "^3.0"
    },
    "autoload": {
        "classmap": [
            "includes/",
            "admin/class-wp-movie-collector-admin.php",
            "public/class-wp-movie-collector-public.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "WP_Movie_Collector\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "test": "phpunit",
        "test:filter": "phpunit --filter"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    }
}
